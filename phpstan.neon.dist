parameters:
    level: max
    paths:
        - src
        - tests
        - tools
    excludePaths:
        - tests/Fixtures/*
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    tipsOfTheDay: false
    reportWrongPhpDocTypeInVarTag: true
