{
    "name": "alto/font",
    "description": "Font reading, metadata, writing, and Unicode subsetting for OpenType, TrueType, WOFF, and WOFF2.",
    "keywords": [
        "font",
        "opentype",
        "truetype",
        "woff",
        "woff2"
    ],
    "homepage": "https://altophp.com/font",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/altophp/font/issues",
        "source": "https://github.com/altophp/font",
        "docs": "https://altophp.com/font"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-iconv": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "ext-brotli": "Compresses WOFF2 in BROTLI_FONT mode and decompresses it without a child process.",
        "brotli": "Provides process-backed Brotli compression and decompression when ext-brotli is unavailable."
    },
    "autoload": {
        "psr-4": {
            "Alto\\Font\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\Font\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": "@qa",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs-check": "@cs",
        "cs-fix": "@cs:fix",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "phpstan": "@sa",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "phpunit",
        "validate-opentype": "php tools/validate-opentype.php"
    }
}
